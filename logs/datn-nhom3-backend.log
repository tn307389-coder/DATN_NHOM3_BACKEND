    SELECT
        lh.* 
    FROM
        lich_hoc lh 
    JOIN
        lop_hoc lop 
            ON lh.malop = lop.malop 
    JOIN
        khoa_hoc kh 
            ON lop.makh = kh.makh 
    JOIN
        dang_ky_khoa_hoc dk 
            ON dk.makh = kh.makh 
            AND dk.mahv = ? 
    WHERE
        (
            ? IS NULL 
            OR lh.ngayhoc >= ?
        ) 
        AND (
            ? IS NULL 
            OR lh.ngayhoc <= ?
        ) 
    ORDER BY
        lh.ngayhoc ASC
